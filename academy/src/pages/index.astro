---
import Base from "../layouts/Base.astro";
import { tiers, units, programme } from "../data/programme.js";
import data from "../data/scenarios.json";
import { caseMeta } from "../data/caseSlugs.js";

const nFor = (uid) => data.scenarios.filter((s) => s.unit === uid).length;
// A few scenarios that show the range, picked for how vivid the real case is.
const featured = ["U2-M02", "U5-M03", "U9-M01", "U10-M01", "U4-S01", "U8-M01"]
  .map((id) => data.scenarios.find((s) => s.id === id))
  .filter(Boolean);
---
<Base title="Master AI, from zero to job-ready">
  <style>
    .hero{background:radial-gradient(1000px 420px at 20% -20%,#1e40af 0%,#0B1F3A 60%);color:#fff;
      border-radius:20px;padding:44px 32px;box-shadow:var(--shadow)}
    .hero h1{color:#fff;max-width:19ch}
    .hero p{color:#c7d2fe;max-width:64ch;font-size:1.08rem}
    .hero .pill{background:rgba(255,255,255,.12);color:#c7d2fe}
    .btn-white{background:#fff;color:var(--ink)}
    .btn-outline{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.45)}
    .stagecard{text-decoration:none;color:inherit;display:block;transition:.15s}
    .stagecard:hover{border-color:var(--accent);transform:translateY(-2px)}
    .uid{width:34px;height:34px;border-radius:9px;background:var(--ink);color:#fff;display:grid;
      place-items:center;font-weight:700;font-size:13px;flex:none}
  </style>

  <section class="hero">
    <span class="pill">Self-paced · programme v{programme.version}</span>
    <h1>Master AI, from zero to job-ready.</h1>
    <p>
      A complete self-paced path built on <strong>{programme.scenarioCount} mandatory practice scenarios</strong>,
      every one derived from a real production case study — what a company actually built, what it measured,
      and what went wrong. Start in your third year, finish before you graduate.
    </p>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:22px">
      <a class="btn btn-white" href="/scenarios">See the {programme.scenarioCount} scenarios</a>
      <a class="btn btn-outline" href="/programme">How the programme works</a>
    </div>
  </section>

  <section class="grid" style="grid-template-columns:repeat(4,1fr);margin-top:26px">
    <div class="card stat"><b>{programme.scenarioCount}</b><span>mandatory scenarios · ~{programme.scenarioHours} h of real practice</span></div>
    <div class="card stat"><b>{caseMeta.usable}</b><span>verified case studies from {programme.organisations} organisations</span></div>
    <div class="card stat"><b>12</b><span>core units, each ending in a shippable artifact</span></div>
    <div class="card stat"><b style="color:var(--ok)">₹0</b><span>runs on an 8 GB laptop · no GPU, no cloud bill</span></div>
  </section>

  <section style="margin-top:46px">
    <h2>Built on what actually happened</h2>
    <p class="muted" style="max-width:84ch">
      Most courses teach the happy path. This one is built from {caseMeta.usable} production case studies that
      were retrieved from primary sources and adversarially fact-checked — engineering blogs, applied-track
      papers, published postmortems, regulator findings and court rulings. Verification rewrote
      <strong>{caseMeta.corrected} of {caseMeta.harvested}</strong> claims before any of it reached a scenario.
    </p>
    <div class="grid" style="grid-template-columns:repeat(3,1fr);margin-top:16px">
      {featured.map((s) => (
        <a class={`sc ${s.size}`} href={`/scenarios/${s.id.toLowerCase()}`}>
          <span class="sid">{s.id}</span>
          <h3 style="margin:6px 0 0;font-size:1.02rem">{s.title}</h3>
          <p class="muted" style="font-size:12.6px;margin:6px 0 0"><strong>{s.org}</strong></p>
          <p style="font-size:13px;margin:8px 0 0">{s.what.charAt(0).toUpperCase() + s.what.slice(1, 150)}{s.what.length > 150 ? "…" : ""}</p>
        </a>
      ))}
    </div>
    <p style="margin-top:18px"><a class="btn btn-ghost" href="/case-studies">Browse the evidence base →</a></p>
  </section>

  <section style="margin-top:46px">
    <h2>Three tiers</h2>
    <p class="muted">Self-paced where a machine can grade you. Instructor-led where only a human can.</p>
    <div class="grid" style="grid-template-columns:repeat(3,1fr);margin-top:14px">
      {tiers.map((t) => (
        <a class={`card stagecard tierc ${t.accent}`} href="/programme">
          <span class="pill d">{t.n}</span>
          <h3 style="margin:8px 0 2px">{t.name}</h3>
          <p style="font-weight:600;font-size:13.5px;margin:0;color:var(--accent)">{t.tagline}</p>
          <p class="muted" style="font-size:13.2px;margin:10px 0 10px">{t.blurb}</p>
          <span class="pill">{t.hours} h{t.hoursNote ? ` ${t.hoursNote}` : ""}</span>
          <span class="pill d">{t.delivery}</span>
        </a>
      ))}
    </div>
  </section>

  <section style="margin-top:46px">
    <h2>The twelve core units</h2>
    <p class="muted">Every module practised, not skimmed — because practising one thing deeply does not transfer to the next thing.</p>
    <div class="grid" style="grid-template-columns:repeat(3,1fr);margin-top:14px">
      {units.map((u) => (
        <a class="card stagecard" href="/programme">
          <div style="display:flex;gap:11px;align-items:center">
            <span class="uid">{u.id}</span>
            <div>
              <h3 style="margin:0;font-size:1rem">{u.name}</h3>
              <span class="muted" style="font-size:12.5px">{nFor(u.id)} scenarios · {u.env}</span>
            </div>
          </div>
          <p class="muted" style="font-size:13px;margin:10px 0 0"><strong>Ships:</strong> {u.artifact}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="card" style="margin-top:46px;background:var(--ink);color:#fff">
    <h2 style="color:#fff">Then a real project, with a real supervisor</h2>
    <p style="max-width:74ch;margin-bottom:14px">
      Tier 3 adds the things a self-paced course structurally cannot produce: code reviewed by a person, a
      stakeholder who changes their mind, an incident you did not cause, and a named professional who will
      vouch for you. Ninety supervised hours on a live project for a real partner.
    </p>
    <a class="btn btn-white" href="/ojt">How the live project runs →</a>
  </section>

  <section style="margin-top:40px">
    <div class="note">
      <strong>Course material is being added progressively.</strong> This portal publishes the full programme
      specification — units, scenarios with their real-world provenance, the verified case-study evidence base,
      and the Tier 3 operating manual. Lesson content and lab repositories attach to each unit here as they are
      produced.
    </div>
  </section>
</Base>
