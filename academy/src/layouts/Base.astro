---
import { meta } from "../data/curriculum.js";
const { title, description = "The Anvi Innovate AI Academy curriculum — an NSQF-aligned, industry-validated programme taking learners from foundations to job-ready across six AI roles.", wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://ai.anviinnovate.com").href;
const nav = [
  { href: "/curriculum", label: "Curriculum" },
  { href: "/tracks", label: "Role tracks" },
  { href: "/scenarios", label: "Work scenarios" },
  { href: "/assessment", label: "Assessment" },
  { href: "/compliance", label: "Compliance" },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title} — Anvi Innovate AI Academy</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Anvi Innovate AI Academy" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="twitter:card" content="summary" />
  <style is:global>
    :root{--ink:#0B1F3A;--accent:#2563EB;--accent2:#0891b2;--surface:#f8fafc;--card:#fff;
      --text:#0f172a;--muted:#475569;--border:#e2e8f0;--ok:#15803d;--warn:#b45309;
      --shadow:0 1px 3px rgba(15,23,42,.05),0 8px 24px rgba(15,23,42,.05);--radius:12px}
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;min-height:100dvh;display:flex;flex-direction:column;overflow-x:hidden;
      font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,sans-serif;
      background:var(--surface);color:var(--text);line-height:1.6}
    h1,h2,h3,h4{color:var(--ink);line-height:1.2;letter-spacing:-.02em}
    h1{font-size:clamp(1.8rem,4vw,2.6rem);margin:.2em 0 .3em}
    h2{font-size:clamp(1.3rem,2.6vw,1.7rem);margin:0 0 .3em}
    h3{font-size:1.1rem;margin:0 0 .3em}
    a{color:var(--accent)}
    main{flex:1;width:100%;max-width:1100px;margin:0 auto;padding:40px 22px 72px}
    main.wide{max-width:1280px}
    header.nav{position:sticky;top:0;z-index:50;display:flex;justify-content:space-between;align-items:center;
      gap:14px;padding:12px 22px;background:rgba(255,255,255,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--border)}
    header.nav .brand{display:inline-flex;align-items:center;gap:9px;text-decoration:none;color:var(--ink);font-weight:700;white-space:nowrap}
    header.nav .brand small{display:block;font-weight:500;font-size:11px;color:var(--muted);letter-spacing:0}
    header.nav nav{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
    header.nav nav a{color:var(--muted);text-decoration:none;font-weight:500;font-size:14px;padding:7px 11px;border-radius:8px}
    header.nav nav a:hover{color:var(--ink);background:#f1f5f9}
    header.nav nav a[aria-current]{color:var(--accent);background:#eff6ff;font-weight:600}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:10px 18px;border-radius:10px;
      text-decoration:none;font-weight:600;font-size:14.5px;cursor:pointer;border:1px solid transparent}
    .btn-primary{background:var(--accent);color:#fff;box-shadow:0 6px 16px rgba(37,99,235,.22)}
    .btn-ghost{background:#fff;color:var(--ink);border:1px solid var(--border)}
    .card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;box-shadow:var(--shadow)}
    .grid{display:grid;gap:16px}
    @media(max-width:920px){.grid{grid-template-columns:repeat(2,1fr)!important}}
    @media(max-width:640px){.grid{grid-template-columns:1fr!important}}
    .muted{color:var(--muted)}
    .pill{display:inline-block;padding:3px 10px;border-radius:999px;background:#eff6ff;color:var(--accent);font-size:12px;font-weight:600}
    .pill.g{background:#dcfce7;color:#166534}.pill.o{background:#fef3c7;color:#92400e}.pill.d{background:#f1f5f9;color:#334155}
    .tw{overflow-x:auto;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow)}
    table{border-collapse:collapse;width:100%;font-size:13.5px;min-width:560px}
    th,td{text-align:left;padding:9px 12px;border-bottom:1px solid var(--border);vertical-align:top}
    thead th{background:#f1f5f9;font-weight:700;color:var(--ink)}
    tbody tr:last-child td{border-bottom:none}
    tbody tr:nth-child(even){background:#fbfdff}
    code{background:#f1f5f9;padding:1px 6px;border-radius:5px;font-size:12.5px}
    .chip{display:inline-block;background:#f1f5f9;color:#334155;font-size:12px;font-weight:500;padding:3px 9px;border-radius:6px;margin:2px 3px 0 0}
    .scn{background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:13px 15px;font-size:13.5px;color:#14532d}
    .note{background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:13px 15px;font-size:13.5px;color:#1e3a8a}
    .warnbox{background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:13px 15px;font-size:13.5px;color:#713f12}
    ul.tight{margin:6px 0;padding-left:20px}ul.tight li{margin:3px 0}
    footer.site{border-top:1px solid var(--border);background:#fff}
    footer.site .inner{max-width:1100px;margin:0 auto;padding:30px 22px;display:grid;gap:20px;grid-template-columns:2fr 1fr 1fr;color:var(--muted);font-size:13.5px}
    @media(max-width:760px){footer.site .inner{grid-template-columns:1fr}}
    footer.site h4{font-size:13px;margin:0 0 8px}
    footer.site a{color:var(--muted);text-decoration:none;display:block;padding:3px 0}
    @media(max-width:860px){header.nav nav a:not(.cta){display:none}}
  </style>
</head>
<body>
  <header class="nav">
    <a class="brand" href="/">
      <img src="/favicon.svg" width="26" height="26" alt="" />
      <span>Anvi Innovate<small>AI Academy · curriculum v{meta.version}</small></span>
    </a>
    <nav>
      {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}>{n.label}</a>)}
      <a class="btn btn-ghost cta" href="https://anviinnovate.com">Main site →</a>
    </nav>
  </header>

  <main class={wide ? "wide" : ""}><slot /></main>

  <footer class="site">
    <div class="inner">
      <div>
        <h4>Anvi Innovate AI Academy</h4>
        Curriculum version {meta.version} · {meta.totalHours} hours · aligned to QP {meta.qp.code} (NSQF Level {meta.qp.nsqfLevel}).<br />
        Hyderabad, Telangana, India · <a style="display:inline" href="mailto:hello@anviinnovate.com">hello@anviinnovate.com</a>
      </div>
      <div>
        <h4>Programme</h4>
        <a href="/curriculum">Curriculum</a><a href="/tracks">Role tracks</a><a href="/scenarios">Work scenarios</a>
      </div>
      <div>
        <h4>Standards</h4>
        <a href="/assessment">Assessment</a><a href="/compliance">Compliance &amp; NSQF</a><a href="https://anviinnovate.com">Anvi Innovate</a>
      </div>
    </div>
  </footer>
</body>
</html>
