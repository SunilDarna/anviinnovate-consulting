---
const { title = "Anvi Innovate" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root { --ink:#0B1F3A; --accent:#2563EB; --surface:#F8FAFC; --text:#0F172A; }
      * { box-sizing: border-box; }
      body { margin:0; font-family: Inter, system-ui, sans-serif; background: var(--surface); color: var(--text); }
      header { display:flex; justify-content:space-between; align-items:center; padding:16px 32px; background:#fff; border-bottom:1px solid #e2e8f0; }
      header a.logo { font-weight:700; color:var(--ink); text-decoration:none; font-size:20px; }
      main { max-width:960px; margin:0 auto; padding:48px 24px; }
    </style>
  </head>
  <body>
    <header>
      <a class="logo" href="/">Anvi Innovate</a>
      <slot name="nav" />
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
