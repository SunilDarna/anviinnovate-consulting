---
import AuthStatus from "../components/AuthStatus.jsx";
import ParticleBackground from "../components/ParticleBackground.jsx";
const { title = "Anvi Innovate", description = "Skilled AI/ML talent, on demand. Anvi Innovate trains, assesses, and deploys future-ready resources for clients.", bg = false } = Astro.props;
const nav = [
  { href: "/clients", label: "For Clients" },
  { href: "/candidates", label: "For Candidates" },
  { href: "/training", label: "Training" },
  { href: "/about", label: "About" },
  { href: "/faq", label: "FAQ" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      :root {
        --ink:#0B1F3A; --accent:#2563EB; --accent2:#22D3EE; --surface:#F8FAFC;
        --card:#FFFFFF; --text:#0F172A; --muted:#475569; --success:#16A34A;
        --error:#DC2626; --border:#e2e8f0; --radius:12px;
        --shadow:0 1px 3px rgba(15,23,42,.06),0 8px 24px rgba(15,23,42,.06);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin:0; font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        background: var(--surface); color: var(--text); line-height:1.6; }
      h1,h2,h3 { font-family: "Space Grotesk", Sora, system-ui, sans-serif; line-height:1.15; color:var(--ink); letter-spacing:-.02em; }
      h1 { font-size: clamp(2rem, 5vw, 3.25rem); margin:.2em 0 .3em; }
      h2 { font-size: clamp(1.5rem, 3.5vw, 2.25rem); margin-top:0; }
      a { color: var(--accent); }
      main { max-width: 1080px; margin: 0 auto; padding: 56px 24px 80px; position:relative; z-index:1; }
      header.nav { position: sticky; top:0; z-index:50; display:flex; justify-content:space-between; align-items:center;
        gap:16px; padding:14px 24px; background:rgba(255,255,255,.85); backdrop-filter:blur(10px);
        border-bottom:1px solid var(--border); }
      header.nav .logo { font-family:"Space Grotesk",sans-serif; font-weight:700; color:var(--ink); text-decoration:none; font-size:20px; white-space:nowrap; }
      header.nav nav { display:flex; gap:20px; align-items:center; flex-wrap:wrap; }
      header.nav nav a.link { color:var(--muted); text-decoration:none; font-weight:500; font-size:15px; }
      header.nav nav a.link:hover { color:var(--ink); }
      .btn { display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:12px 20px;
        border-radius:10px; text-decoration:none; font-weight:600; font-size:15px; cursor:pointer; border:1px solid transparent; transition:transform .05s ease, box-shadow .2s; }
      .btn:active { transform: translateY(1px); }
      .btn-primary { background:var(--accent); color:#fff; box-shadow:0 6px 16px rgba(37,99,235,.25); }
      .btn-primary:hover { box-shadow:0 8px 22px rgba(37,99,235,.35); }
      .btn-ghost { background:#fff; color:var(--ink); border:1px solid var(--muted); }
      .card { background:var(--card); border:1px solid var(--border); border-radius:var(--radius); padding:24px; box-shadow:var(--shadow); }
      .grid { display:grid; gap:20px; }
      .muted { color:var(--muted); }
      .pill { display:inline-block; padding:4px 12px; border-radius:999px; background:#EFF6FF; color:var(--accent); font-size:13px; font-weight:600; }
      label { display:block; font-weight:600; font-size:14px; margin:14px 0 6px; }
      input, select, textarea { width:100%; padding:11px 12px; border:1px solid var(--border); border-radius:8px; font:inherit; background:#fff; }
      input:focus, select:focus, textarea:focus { outline:2px solid var(--accent); border-color:var(--accent); }
      .hp { position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden; }
      footer.site { border-top:1px solid var(--border); background:#fff; }
      footer.site .inner { max-width:1080px; margin:0 auto; padding:40px 24px; display:flex; flex-wrap:wrap; gap:24px; justify-content:space-between; color:var(--muted); font-size:14px; }
      footer.site a { color:var(--muted); text-decoration:none; margin-right:16px; }
      @media (max-width:720px){ header.nav nav .link { display:none; } }
    </style>
  </head>
  <body>
    {bg && <ParticleBackground client:idle />}
    <header class="nav">
      <a class="logo" href="/">Anvi Innovate</a>
      <nav>
        {nav.map((n) => <a class="link" href={n.href}>{n.label}</a>)}
        <a class="btn btn-ghost" href="/clients">Hire Talent</a>
        <a class="btn btn-primary" href="/candidates">Apply Now</a>
        <AuthStatus client:idle />
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div class="inner">
        <div>
          <strong style="color:var(--ink)">Anvi Innovate</strong><br/>
          AI/ML talent — trained, assessed, deployed.<br/>
          Hyderabad, Telangana, India · hello@anviinnovate.com
        </div>
        <div>
          <a href="/about">About</a><a href="/faq">FAQ</a><a href="/contact">Contact</a>
          <a href="/privacy">Privacy</a><a href="/terms">Terms</a>
          <div style="margin-top:12px;">© {new Date().getFullYear()} Anvi Innovate. In collaboration with ai-certify.in.</div>
        </div>
      </div>
    </footer>
  </body>
</html>
