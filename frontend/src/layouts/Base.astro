---
import AuthStatus from "../components/AuthStatus.jsx";
import ParticleBackground from "../components/ParticleBackground.jsx";
const {
  title = "Anvi Innovate",
  description = "Skilled AI/ML talent, on demand. Anvi Innovate trains, assesses, and deploys future-ready resources for clients.",
  bg = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://anviinnovate.com").href;
const nav = [
  { href: "/clients", label: "For Clients" },
  { href: "/candidates", label: "For Candidates" },
  { href: "/training", label: "Training" },
  { href: "/about", label: "About" },
  { href: "/faq", label: "FAQ" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Anvi Innovate" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preload" href="/fonts/space-grotesk-700.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <style is:global>
      /* Self-hosted fonts (Latin subset, woff2) — no third-party request, no CLS. */
      @font-face { font-family:"Inter"; font-style:normal; font-weight:400; font-display:swap; src:url("/fonts/inter-400.woff2") format("woff2"); }
      @font-face { font-family:"Inter"; font-style:normal; font-weight:600; font-display:swap; src:url("/fonts/inter-600.woff2") format("woff2"); }
      @font-face { font-family:"Space Grotesk"; font-style:normal; font-weight:600; font-display:swap; src:url("/fonts/space-grotesk-600.woff2") format("woff2"); }
      @font-face { font-family:"Space Grotesk"; font-style:normal; font-weight:700; font-display:swap; src:url("/fonts/space-grotesk-700.woff2") format("woff2"); }

      :root {
        --ink:#0B1F3A; --accent:#2563EB; --accent2:#22D3EE; --surface:#F8FAFC;
        --card:#FFFFFF; --text:#0F172A; --muted:#475569; --success:#15803D; --success-mark:#16A34A;
        --error:#DC2626; --border:#e2e8f0; --radius:12px;
        --shadow:0 1px 3px rgba(15,23,42,.06),0 8px 24px rgba(15,23,42,.06);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin:0; min-height:100dvh; display:flex; flex-direction:column; overflow-x:hidden;
        font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        background: var(--surface); color: var(--text); line-height:1.6; }
      h1,h2,h3 { font-family: "Space Grotesk", system-ui, sans-serif; line-height:1.15; color:var(--ink); letter-spacing:-.02em; }
      h1 { font-size: clamp(2rem, 5vw, 3.25rem); margin:.2em 0 .3em; }
      h2 { font-size: clamp(1.5rem, 3.5vw, 2.25rem); margin-top:0; }
      a { color: var(--accent); }
      main { flex:1; width:100%; max-width: 1080px; margin: 0 auto; padding: 56px 24px 80px; position:relative; z-index:1; }
      header.nav { position: sticky; top:0; z-index:50; display:flex; justify-content:space-between; align-items:center;
        gap:16px; padding:14px 24px; background:rgba(255,255,255,.85); backdrop-filter:blur(10px);
        border-bottom:1px solid var(--border); }
      header.nav .logo { font-family:"Space Grotesk",sans-serif; font-weight:700; color:var(--ink); text-decoration:none; font-size:20px; white-space:nowrap; display:inline-flex; align-items:center; gap:8px; }
      header.nav nav.links { display:flex; gap:20px; align-items:center; flex-wrap:wrap; }
      header.nav nav.links a.link { color:var(--muted); text-decoration:none; font-weight:500; font-size:15px; }
      header.nav nav.links a.link:hover { color:var(--ink); }
      .btn { display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:12px 20px;
        border-radius:10px; text-decoration:none; font-weight:600; font-size:15px; cursor:pointer; border:1px solid transparent; transition:transform .05s ease, box-shadow .2s; }
      .btn:active { transform: translateY(1px); }
      .btn-primary { background:var(--accent); color:#fff; box-shadow:0 6px 16px rgba(37,99,235,.25); }
      .btn-primary:hover { box-shadow:0 8px 22px rgba(37,99,235,.35); }
      .btn-ghost { background:#fff; color:var(--ink); border:1px solid var(--muted); }
      .card { background:var(--card); border:1px solid var(--border); border-radius:var(--radius); padding:24px; box-shadow:var(--shadow); }
      /* Responsive grids: collapse hard-coded inline column counts on small screens. */
      .grid { display:grid; gap:20px; }
      @media (max-width:900px){ .grid { grid-template-columns:repeat(2,1fr) !important; } }
      @media (max-width:620px){ .grid { grid-template-columns:1fr !important; } }
      .muted { color:var(--muted); }
      .pill { display:inline-block; padding:4px 12px; border-radius:999px; background:#EFF6FF; color:var(--accent); font-size:13px; font-weight:600; }
      label { display:block; font-weight:600; font-size:14px; margin:14px 0 6px; }
      input, select, textarea { width:100%; padding:11px 12px; border:1px solid var(--border); border-radius:8px; font:inherit; background:#fff; }
      input:focus, select:focus, textarea:focus { outline:2px solid var(--accent); border-color:var(--accent); }
      .hp { position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden; }

      /* Hamburger (mobile) */
      #navToggle { display:none; background:none; border:1px solid var(--border); border-radius:8px; padding:8px 10px; cursor:pointer; }
      #navToggle svg { display:block; }
      #mobileNav { display:none; }
      @media (max-width:860px){
        header.nav nav.links { display:none; }
        #navToggle { display:inline-flex; }
        #mobileNav.open { display:flex; }
        #mobileNav { position:fixed; inset:64px 0 auto 0; z-index:49; flex-direction:column; gap:4px;
          background:#fff; border-bottom:1px solid var(--border); padding:12px 24px 20px; box-shadow:var(--shadow); }
        #mobileNav a { padding:12px 8px; text-decoration:none; color:var(--ink); font-weight:600; border-bottom:1px solid var(--border); }
        #mobileNav .btn { margin-top:10px; }
      }

      footer.site { border-top:1px solid var(--border); background:#fff; }
      footer.site .inner { max-width:1080px; margin:0 auto; padding:40px 24px; display:grid; gap:28px;
        grid-template-columns:repeat(3,1fr); color:var(--muted); font-size:14px; }
      @media (max-width:760px){ footer.site .inner { grid-template-columns:1fr; } }
      footer.site h4 { color:var(--ink); font-size:14px; margin:0 0 10px; }
      footer.site a { color:var(--muted); text-decoration:none; display:inline-block; padding:8px 10px; margin:0 -10px; }
      footer.site a:hover { color:var(--ink); }
      footer.site .fraud { grid-column:1 / -1; border-top:1px solid var(--border); padding-top:16px; font-style:italic; }
    </style>
  </head>
  <body>
    {bg && <ParticleBackground client:idle />}
    <header class="nav">
      <a class="logo" href="/"><img src="/favicon.svg" width="24" height="24" alt="" /> Anvi Innovate</a>
      <nav class="links">
        {nav.map((n) => <a class="link" href={n.href}>{n.label}</a>)}
        <a class="btn btn-ghost" href="/clients">Hire Talent</a>
        <a class="btn btn-primary" href="/candidates">Apply Now</a>
        <AuthStatus client:idle />
      </nav>
      <button id="navToggle" aria-label="Menu" aria-expanded="false" aria-controls="mobileNav">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </header>
    <nav id="mobileNav" aria-label="Mobile">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <a class="btn btn-ghost" href="/clients">Hire Talent</a>
      <a class="btn btn-primary" href="/candidates">Apply Now</a>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div class="inner">
        <div>
          <h4>Anvi Innovate</h4>
          AI/ML talent — trained, assessed, deployed.<br/>
          Hyderabad, Telangana, India<br/>
          <a href="mailto:hello@anviinnovate.com">hello@anviinnovate.com</a>
          <!-- TODO (needs real values): registered entity name, CIN, GST, registered office address -->
        </div>
        <div>
          <h4>For Clients</h4>
          <a href="/clients">Hire talent</a><br/>
          <a href="/services/hire-train-deploy">Hire-train-deploy</a><br/>
          <a href="/faq">Client FAQ</a><br/>
          <a href="/contact">Contact</a>
        </div>
        <div>
          <h4>For Candidates</h4>
          <a href="/candidates">Apply</a><br/>
          <a href="/candidates/assessment">Assessment</a><br/>
          <a href="/training">Training</a><br/>
          <a href="/faq">Candidate FAQ</a>
        </div>
        <div style="grid-column:1 / -1; display:flex; flex-wrap:wrap; gap:0 16px; align-items:center;">
          <a href="/about">About</a><a href="/faq">FAQ</a><a href="/contact">Contact</a>
          <a href="/privacy">Privacy</a><a href="/terms">Terms</a>
          <span style="margin-left:auto;">© {new Date().getFullYear()} Anvi Innovate · in collaboration with <a style="display:inline;padding:0;margin:0;" href="https://bxup.in/" target="_blank" rel="noopener noreferrer">bxup.in</a></span>
        </div>
        <p class="fraud">Anvi Innovate never charges candidates a fee at any stage of hiring. We contact you only from <b>@anviinnovate.com</b> addresses. Questions or feedback? Email <a style="display:inline;padding:0;margin:0;" href="mailto:hello@anviinnovate.com">hello@anviinnovate.com</a>.</p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById("navToggle");
        var panel = document.getElementById("mobileNav");
        if (!btn || !panel) return;
        btn.addEventListener("click", function () {
          var open = panel.classList.toggle("open");
          btn.setAttribute("aria-expanded", open ? "true" : "false");
        });
        panel.addEventListener("click", function (e) {
          if (e.target.tagName === "A") { panel.classList.remove("open"); btn.setAttribute("aria-expanded", "false"); }
        });
      })();
    </script>
  </body>
</html>
