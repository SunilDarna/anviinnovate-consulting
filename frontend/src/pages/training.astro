---
import Base from "../layouts/Base.astro";
---
<Base title="Training — Anvi Innovate">
  <span class="pill">Training</span>
  <h1>Training modules — coming soon</h1>
  <div class="card" style="max-width:720px;">
    <p>We're building structured AI/ML and GenAI training <strong>in collaboration with ai-certify.in</strong>. Modules will cover foundations through applied LLM and prompt-engineering skills.</p>
    <p class="muted">Candidates in a post-assessment cooldown retain full access to training while they prepare to retry.</p>
    <a class="btn btn-primary" href="/candidates">Apply as a candidate</a>
  </div>
</Base>
