---
import Base from "../../layouts/Base.astro";
import CandidateForm from "../../components/CandidateForm.jsx";
---
<Base title="Create your candidate profile — Anvi Innovate"
  description="Create your Anvi Innovate candidate profile: your background, skills, preferences and resume. Get matched to real AI/ML projects.">
  <span class="pill">For Candidates</span>
  <h1>Create your candidate profile</h1>
  <p class="muted" style="max-width:680px;">Sign in with Google, tell us about your background and skills, and upload your resume. We'll match you to client AI/ML projects.</p>
  <div style="max-width:760px; margin-top:24px;">
    <CandidateForm client:only="react" />
  </div>
</Base>
