---
import Base from "../../../layouts/Base.astro";
---
<Base title="AI/ML Foundations Assessment — Anvi Innovate">
  <span class="pill">Assessment</span>
  <h1>AI/ML Foundations Assessment</h1>
  <div class="card" style="max-width:760px;">
    <ul class="muted" style="padding-left:18px;">
      <li><strong>30 questions</strong> — 3 from each of 10 core categories, unique every attempt.</li>
      <li><strong>30 minutes</strong> — the timer is enforced server-side; submissions auto-score at time-up.</li>
      <li><strong>85% to pass</strong> (26 of 30 correct).</li>
      <li><strong>One attempt at a time.</strong> If you don't pass, a 30-day cooldown applies before you can retry.</li>
      <li>You must be <strong>signed in</strong> and have submitted your application.</li>
    </ul>
    <p class="muted">Make sure you have a stable connection and 30 uninterrupted minutes. Closing the tab won't stop the timer.</p>
    <a class="btn btn-primary" href="/candidates/assessment/exam">Start assessment</a>
    <a class="btn btn-ghost" href="/candidates/apply" style="margin-left:10px;">Back to application</a>
  </div>
</Base>
