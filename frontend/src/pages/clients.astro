---
import Base from "../layouts/Base.astro";
import ClientForm from "../components/ClientForm.jsx";
---
<Base title="Hire on-demand AI/ML talent — Anvi Innovate"
  description="On-demand, trained AI/ML, GenAI and Applied AI talent — assessed fresh graduates ready for immediate deployment. Contract staffing, contract-to-hire and hire-train-deploy.">
  <span class="pill">Talent on demand</span>
  <h1>On-demand AI/ML talent, ready for immediate deployment</h1>
  <p class="muted" style="font-size:1.15rem; max-width:740px;">
    We have trained AI, ML, GenAI and Applied-AI fresh graduates available for immediate deployment. Tell us your requirement — skills, number of resources, and timeline — and we'll place ready talent on your team in days.
  </p>

  <div class="grid" style="grid-template-columns:1.2fr 1fr; align-items:start; margin-top:28px;">
    <ClientForm client:load />
    <div>
      <div class="card">
        <h3 style="margin-top:0;">Why teams choose us</h3>
        <ul class="muted" style="padding-left:18px; margin-bottom:0;">
          <li><strong>Immediate deployment</strong> — pre-trained, screened talent, onboarded in days.</li>
          <li><strong>Applied AI &amp; GenAI</strong> — RAG, RLHF, fine-tuning, annotation, prompt engineering.</li>
          <li><strong>Fresh, motivated talent</strong> — freshers and career-switchers, screened for aptitude.</li>
          <li><strong>Flexible engagement</strong> — contract staffing, contract-to-hire, hire-train-deploy.</li>
        </ul>
      </div>
      <div class="card" style="margin-top:16px;">
        <h3 style="margin-top:0;">How it works</h3>
        <ol class="muted" style="padding-left:18px; margin-bottom:0;">
          <li>Tell us your need — this form takes a minute.</li>
          <li>We match ready, trained talent to your requirement.</li>
          <li>Deploy and scale up or down on your terms.</li>
        </ol>
      </div>
    </div>
  </div>

  <p class="muted" style="margin-top:20px;">Prefer email? Write to <a href="mailto:hello@anviinnovate.com">hello@anviinnovate.com</a> — we reply within one business day.</p>
</Base>
