---
import Base from "../layouts/Base.astro";
---
<Base title="Train. Get assessed. Get deployed. — Anvi Innovate">
  <span class="pill">For Candidates</span>
  <h1>Train. Get assessed. Get deployed.</h1>
  <p class="muted" style="font-size:1.15rem; max-width:720px;">
    Your domain expertise is the training data behind modern AI. Apply, prove your foundations, and get deployed to real AI/ML projects.
  </p>
  <div style="display:flex; gap:14px; flex-wrap:wrap; margin:24px 0 8px;">
    <a class="btn btn-primary" href="/candidates/apply">Apply now</a>
    <a class="btn btn-ghost" href="/candidates/assessment">About the assessment</a>
  </div>

  <section style="margin-top:48px;">
    <h2>The five steps</h2>
    <div class="grid" style="grid-template-columns:repeat(5,1fr);">
      {[
        ["1","Apply","Sign in with Google and submit your profile."],
        ["2","Assess","30 questions, 30 minutes, 85% to pass."],
        ["3","Train","Upskill with bxup.in modules."],
        ["4","Deploy","Join real client projects."],
        ["5","Grow","Earn and level up over time."],
      ].map(([n,t,d]) => (
        <div class="card"><span class="pill">{n}</span><h3 style="margin:.4em 0;">{t}</h3><p class="muted" style="font-size:14px;">{d}</p></div>
      ))}
    </div>
  </section>

  <section class="card" style="margin-top:40px;">
    <h3 style="margin-top:0;">What the assessment covers</h3>
    <p class="muted">Ten core areas — Math & Statistics, Core ML, Supervised & Unsupervised Learning, Model Evaluation, Neural Networks, NLP, GenAI & LLMs, Prompt Engineering, and Transformers & Attention. Three questions are drawn from each, for a unique 30-question set every attempt.</p>
    <a class="btn btn-primary" href="/candidates/apply">Start your application</a>
  </section>
</Base>
