---
import Base from "../layouts/Base.astro";
---
<Base title="Contact — Anvi Innovate" description="Contact Anvi Innovate to hire on-demand AI/ML talent. Email hello@anviinnovate.com — we reply within one business day.">
  <span class="pill">Contact</span>
  <h1>Get in touch</h1>
  <p class="muted" style="max-width:680px;">Looking to hire AI/ML talent? Tell us your role, volume, location and timeline and we'll come back with a plan — within one business day.</p>

  <div class="card" style="max-width:620px; margin-top:24px;">
    <h3 style="margin-top:0;">Request talent</h3>
    <p class="muted">Submit a short hiring request and we'll match trained, ready talent to your requirement.</p>
    <a class="btn btn-primary" href="/clients">Submit a hiring request</a>
    <p class="muted" style="font-size:14px; margin-bottom:0; margin-top:12px;">Or email <a href="mailto:hello@anviinnovate.com">hello@anviinnovate.com</a>.</p>
  </div>

  <div class="card" style="max-width:620px; margin-top:16px;">
    <p class="muted" style="margin:0;"><strong>Anvi Innovate</strong> · Hyderabad, Telangana, India</p>
    <p class="muted" style="margin:8px 0 0;">For partnerships, press, or feedback about the site, email <a href="mailto:hello@anviinnovate.com">hello@anviinnovate.com</a>. We read every message.</p>
  </div>
</Base>
