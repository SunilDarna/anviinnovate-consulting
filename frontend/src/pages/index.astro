---
import Base from "../layouts/Base.astro";
import { tiers, fdeTrack, tracks, marketStats, buyerContext,
         curriculumProof, commercialProof } from "../data/site.js";
const primary = tracks.filter((t) => t.primary);
const secondary = tracks.filter((t) => !t.primary);
const fde = tiers.find((t) => t.lead);
const trained = tiers.find((t) => !t.lead);
---
<Base title="Anvi Innovate — Forward Deployed AI Engineers, ready to embed"
  description="AI-native Forward Deployed Engineers who take AI systems from prototype to production inside your team, plus assessed early-career engineers for volume programmes. Serving teams across India.">

  <style>
    .hero { position:relative; text-align:center; color:#fff; border-radius:24px; overflow:hidden;
      padding:56px 24px 60px; margin-top:8px;
      background:radial-gradient(1200px 500px at 50% -10%, #1e40af 0%, #0B1F3A 55%, #0B1F3A 100%); }
    .hero h1 { color:#fff; max-width:920px; margin:14px auto 16px; }
    .hero p.sub { color:#c7d2fe; font-size:1.2rem; max-width:740px; margin:0 auto 26px; }
    .hero .pill { background:rgba(255,255,255,.12); color:#c7d2fe; }
    .btn-white { background:#fff; color:var(--ink); }
    .btn-white:hover { box-shadow:0 8px 22px rgba(0,0,0,.25); }
    .btn-outline-w { background:transparent; color:#fff; border:1px solid rgba(255,255,255,.5); }
    .cta-row { display:flex; gap:14px; justify-content:center; flex-wrap:wrap; }
    .icon { width:40px; height:40px; border-radius:10px; background:#EFF6FF; color:var(--accent); display:grid; place-items:center; font-weight:700; }
    .tier { border-top:4px solid var(--border); }
    .tier.lead { border-top-color:var(--accent); }
    .stage { display:flex; gap:12px; padding:9px 0; border-bottom:1px solid var(--border); font-size:14px; }
    .stage:last-child { border-bottom:none; }
    .stage b { min-width:132px; color:var(--ink); }
    .stage .h { min-width:46px; color:var(--muted); font-size:13px; }
    @media (max-width:640px){ .stage{flex-wrap:wrap;gap:4px} .stage b{min-width:0} }
  </style>

  <section class="hero">
    <span class="pill">Forward Deployed AI Engineering · India</span>
    <h1>Engineers who take AI from prototype to production — inside your team.</h1>
    <p class="sub">
      AI-native Forward Deployed Engineers who have already worked the failure modes: legacy data,
      retrieval that misses, agents that loop, evals that catch it before your users do.
    </p>
    <div class="cta-row">
      <a class="btn btn-white" href="/clients">Request engineers</a>
      <a class="btn btn-outline-w" href="/commitments">What we commit to</a>
    </div>
  </section>

  <!-- The two tiers -->
  <section style="margin-top:48px;">
    <h2 style="text-align:center;">Two ways to staff the work</h2>
    <p class="muted" style="text-align:center; max-width:640px; margin:.3em auto 0;">
      Most teams need one senior who can own the system, and capacity underneath. We supply both,
      and we are explicit about which is which.
    </p>
    <div class="grid" style="grid-template-columns:1.15fr 1fr; margin-top:20px;">
      <div class="card tier lead">
        <span class="pill">Lead offer · {fde.band}</span>
        <h3 style="margin:.5em 0 .3em; font-size:1.2rem;">{fde.name}</h3>
        <p style="margin:0; font-size:14.5px;">{fde.desc}</p>
        <p class="muted" style="margin:12px 0 0; font-size:13.5px;"><strong>The job, in proportion:</strong> {fde.mix}</p>
        <p class="muted" style="margin:6px 0 0; font-size:13.5px;"><strong>Use when:</strong> {fde.for}</p>
      </div>
      <div class="card tier">
        <span class="pill d" style="background:#f1f5f9;color:#334155;">{trained.band}</span>
        <h3 style="margin:.5em 0 .3em; font-size:1.2rem;">{trained.name}</h3>
        <p style="margin:0; font-size:14.5px;">{trained.desc}</p>
        <p class="muted" style="margin:12px 0 0; font-size:13.5px;"><strong>How they deploy:</strong> {trained.mix}</p>
        <p class="muted" style="margin:6px 0 0; font-size:13.5px;"><strong>Use when:</strong> {trained.for}</p>
      </div>
    </div>
  </section>

  <!-- Value props -->
  <section class="grid" style="grid-template-columns:repeat(4,1fr); margin-top:40px;">
    {[
      ["Trained on real failures","The curriculum is built from documented production incidents at named companies — not tutorials."],
      ["Assessed, not just taught","Every engineer passes a scored, hands-on assessment before we put them in front of you."],
      ["You interview first","We shortlist from a trained bench. You decide. Nobody starts without your yes."],
      ["Flexible engagement","Contract staffing, contract-to-hire, and hire-train-deploy."],
    ].map(([t,d]) => (
      <div class="card"><h3 style="margin:.1em 0 .3em; font-size:1.05rem;">{t}</h3><p class="muted" style="margin:0; font-size:14px;">{d}</p></div>
    ))}
  </section>

  <!-- First-party proof -->
  <section class="card" style="margin-top:48px;">
    <h2 style="margin-top:0;">What the training is actually made of</h2>
    <p class="muted" style="font-size:14px; max-width:78ch;">
      Our own numbers, not market forecasts. Every case study behind the curriculum was retrieved from a
      primary engineering source and fact-checked before it was taught.
    </p>
    <div class="grid" style="grid-template-columns:repeat(4,1fr); margin-top:14px;">
      {curriculumProof.map(([v,l]) => (
        <div>
          <div style="font-family:'Space Grotesk',sans-serif; font-size:1.9rem; font-weight:700; color:var(--ink);">{v}</div>
          <p class="muted" style="margin:.1em 0 0; font-size:13.5px;">{l}</p>
        </div>
      ))}
    </div>
    {commercialProof.length > 0 && (
      <div class="grid" style="grid-template-columns:repeat(4,1fr); margin-top:22px; padding-top:18px; border-top:1px solid var(--border);">
        {commercialProof.map(([v,l]) => (
          <div>
            <div style="font-family:'Space Grotesk',sans-serif; font-size:1.9rem; font-weight:700; color:var(--ink);">{v}</div>
            <p class="muted" style="margin:.1em 0 0; font-size:13.5px;">{l}</p>
          </div>
        ))}
      </div>
    )}
  </section>

  <!-- The FDE track -->
  <section style="margin-top:56px;">
    <div style="text-align:center; max-width:780px; margin-inline:auto;">
      <span class="pill">{fdeTrack.totalHours} assessed hours · {fdeTrack.credential.split(" — ")[0]}</span>
      <h2 style="margin-top:14px;">What a Forward Deployed Engineer has already done</h2>
      <p class="muted" style="font-size:1.08rem;">
        Not a syllabus — a sequence of things they have built and been scored on, in the order the work
        actually arrives on an enterprise engagement.
      </p>
    </div>
    <div class="card" style="margin-top:20px;">
      {fdeTrack.stages.map((s) => (
        <div class="stage"><b>{s.n}</b><span class="h">{s.h}</span><span class="muted">{s.d}</span></div>
      ))}
    </div>
  </section>

  <!-- How it works -->
  <section id="how" style="margin-top:56px;">
    <h2 style="text-align:center;">How hiring works</h2>
    <div class="grid" style="grid-template-columns:repeat(3,1fr); margin-top:14px;">
      {[
        ["1","Tell us the role","Skills, headcount and timeline — one short form, about a minute."],
        ["2","We shortlist","Profiles with assessment scores and work samples, so you can judge before you meet anyone."],
        ["3","You interview, then they start","Your interview, your decision, your clearance process."],
      ].map(([n,t,d]) => (
        <div class="card"><div class="icon">{n}</div><h3 style="margin:.5em 0 .2em; font-size:1.05rem;">{t}</h3><p class="muted" style="margin:0; font-size:14px;">{d}</p></div>
      ))}
    </div>
    <div style="text-align:center; margin-top:24px;">
      <a class="btn btn-primary" href="/clients">Request engineers</a>
      <a class="btn btn-ghost" href="/commitments" style="margin-left:8px;">See our commitments →</a>
    </div>
  </section>

  <!-- Tracks -->
  <section style="margin-top:56px;">
    <h3>What we place</h3>
    <div class="grid" style="grid-template-columns:repeat(3,1fr); margin-top:6px;">
      {primary.map((t) => (
        <div class="card" style="border-left:3px solid var(--accent);"><h3 style="margin:0 0 .2em; font-size:1rem;">{t.name}</h3><p class="muted" style="margin:0; font-size:14px;">{t.desc}</p></div>
      ))}
    </div>
    <h3 style="margin-top:28px;">Also available, on demand</h3>
    <p class="muted" style="font-size:14px; margin:.2em 0 10px;">Built to order against a confirmed requirement, rather than held on the bench.</p>
    <div style="display:flex; flex-wrap:wrap; gap:8px;">
      {secondary.map((t) => (<span class="pill" style="font-weight:500; font-size:13.5px;">{t.name}</span>))}
    </div>
    <h3 style="margin-top:32px;">Skills &amp; tech stack</h3>
    <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:6px;">
      {["Prompt & context engineering","Verifying AI output","LLM APIs & structured outputs","RAG & hybrid retrieval","Evals & LLM-as-judge","Agents & MCP","Fine-tuning (LoRA→DPO)","Embeddings & vector search","Reranking","Observability & drift","Cost routing","Responsible AI"].map((s) => (
        <span class="pill" style="font-weight:500;">{s}</span>
      ))}
    </div>
  </section>

  <section class="grid" style="grid-template-columns:repeat(4,1fr); margin-top:44px; text-align:center;">
    {marketStats.map((s) => (
      <div class="card">
        <div style="font-family:'Space Grotesk',sans-serif; font-size:1.8rem; font-weight:700; color:var(--ink);">{s.n}</div>
        <p style="margin:.2em 0 .4em; font-size:14px;">{s.label}</p>
        <p class="muted" style="margin:0; font-size:12px;">{s.src}</p>
      </div>
    ))}
  </section>

  <section class="card" style="margin-top:48px;">
    <h2 style="margin-top:0;">Engagement models</h2>
    <div class="grid" style="grid-template-columns:repeat(3,1fr);">
      <div><h3 style="font-size:1.05rem; margin:.2em 0;">Embedded FDE</h3><p class="muted" style="margin:0; font-size:14px;">One senior engineer inside your team, owning an AI system end to end.</p></div>
      <div><h3 style="font-size:1.05rem; margin:.2em 0;">Pod</h3><p class="muted" style="margin:0; font-size:14px;">An FDE leading two to four assessed engineers, billed per seat.</p></div>
      <div><h3 style="font-size:1.05rem; margin:.2em 0;">Hire-train-deploy</h3><p class="muted" style="margin:0; font-size:14px;">We source, train and deploy against your programme, with conversion to your payroll.</p></div>
    </div>
    <div style="margin-top:16px;"><a class="btn btn-ghost" href="/services/hire-train-deploy">See engagement models →</a></div>
  </section>

  <section class="card" style="margin-top:48px; background:var(--ink); color:#fff;">
    <h2 style="color:#fff;">Built for the teams who are actually hiring</h2>
    <p style="font-size:1.1rem; max-width:790px;">
      Global capability centres are now the dominant buyer of contract engineering talent in India —
      <strong>{buyerContext.gccShare}</strong> of professional staffing headcount at the market leader.
      What they are short of is not people. It is people who can be trusted with an AI system in
      production. That is the gap we train into.
    </p>
    <p class="muted" style="color:#94a3b8; font-size:13px;">
      Sources: {buyerContext.gccSrc}; Indian Staffing Federation (IT staffing {buyerContext.itStaffingGrowth} YoY, FY26).
    </p>
  </section>

  <section style="text-align:center; margin-top:48px;">
    <h2>Tell us the role. We will show you the people.</h2>
    <p class="muted" style="max-width:600px; margin-inline:auto;">A short brief is enough to start. We reply within one business day.</p>
    <div class="cta-row" style="margin-top:8px;">
      <a class="btn btn-primary" href="/clients">Request engineers</a>
      <a class="btn btn-ghost" href="/vendor">Vendor &amp; compliance pack</a>
      <a class="btn btn-ghost" href="mailto:hello@anviinnovate.com">Email us</a>
    </div>
  </section>
</Base>
