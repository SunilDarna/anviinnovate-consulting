---
import Base from "../layouts/Base.astro";
---
<Base title="Anvi Innovate — On-demand, deployment-ready AI/ML talent"
  description="On-demand, trained AI/ML, GenAI and Applied AI talent — fresh graduates ready for immediate deployment. Contract staffing, contract-to-hire and hire-train-deploy from Hyderabad.">

  <style>
    .hero { position:relative; text-align:center; color:#fff; border-radius:24px; overflow:hidden;
      padding:56px 24px 60px; margin-top:8px;
      background:radial-gradient(1200px 500px at 50% -10%, #1e40af 0%, #0B1F3A 55%, #0B1F3A 100%); }
    .hero h1 { color:#fff; max-width:900px; margin:14px auto 16px; }
    .hero p.sub { color:#c7d2fe; font-size:1.2rem; max-width:700px; margin:0 auto 26px; }
    .hero .pill { background:rgba(255,255,255,.12); color:#c7d2fe; }
    .btn-white { background:#fff; color:var(--ink); }
    .btn-white:hover { box-shadow:0 8px 22px rgba(0,0,0,.25); }
    .btn-outline-w { background:transparent; color:#fff; border:1px solid rgba(255,255,255,.5); }
    .cta-row { display:flex; gap:14px; justify-content:center; flex-wrap:wrap; }
    .icon { width:40px; height:40px; border-radius:10px; background:#EFF6FF; color:var(--accent); display:grid; place-items:center; font-weight:700; }
  </style>

  <!-- HERO -->
  <section class="hero">
    <span class="pill">Talent on demand · AI · ML · GenAI · Applied AI</span>
    <h1>On-demand, trained AI/ML talent — ready for immediate deployment.</h1>
    <p class="sub">Applied-AI, GenAI and ML-trained fresh graduates, ready for your team. Tell us your requirement and we deploy in days, not months.</p>
    <div class="cta-row">
      <a class="btn btn-white" href="/clients">Request talent</a>
      <a class="btn btn-outline-w" href="#how">How it works</a>
    </div>
  </section>

  <!-- Value props -->
  <section class="grid" style="grid-template-columns:repeat(4,1fr); margin-top:36px;">
    {[
      ["Immediate deployment","Pre-trained, screened talent onboarded to your team in days."],
      ["Applied AI & GenAI","Skilled in RAG, RLHF, fine-tuning, annotation and prompt engineering."],
      ["Fresh, motivated talent","Fresh graduates and career-switchers, screened for aptitude and rigor."],
      ["Flexible engagement","Contract staffing, contract-to-hire, and hire-train-deploy."],
    ].map(([t,d]) => (
      <div class="card"><h3 style="margin:.1em 0 .3em; font-size:1.05rem;">{t}</h3><p class="muted" style="margin:0; font-size:14px;">{d}</p></div>
    ))}
  </section>

  <!-- How it works -->
  <section id="how" style="margin-top:56px;">
    <h2 style="text-align:center;">Hire in three steps</h2>
    <div class="grid" style="grid-template-columns:repeat(3,1fr); margin-top:14px;">
      {[
        ["1","Tell us your need","Skills, number of resources, and timeline — one short form."],
        ["2","We match ready talent","Trained, screened talent matched to your requirement."],
        ["3","Deploy in days","Embed resources in your team and scale up or down."],
      ].map(([n,t,d]) => (
        <div class="card"><div class="icon">{n}</div><h3 style="margin:.5em 0 .2em; font-size:1.05rem;">{t}</h3><p class="muted" style="margin:0; font-size:14px;">{d}</p></div>
      ))}
    </div>
    <div style="text-align:center; margin-top:24px;"><a class="btn btn-primary" href="/clients">Request talent now</a></div>
  </section>

  <!-- Talent categories -->
  <section style="margin-top:56px;">
    <h2 style="text-align:center;">Talent across the AI stack</h2>
    <div class="grid" style="grid-template-columns:repeat(3,1fr); margin-top:14px;">
      {[
        ["Data annotation & RLHF","Human feedback, labelling and evaluation at quality."],
        ["RAG & LLM applications","Retrieval, embeddings, and applied GenAI workflows."],
        ["Model fine-tuning","Dataset prep, LoRA/PEFT, evaluation and iteration."],
        ["Prompt engineering","Structured prompting, guardrails, and output shaping."],
        ["Core ML","Supervised/unsupervised modelling and evaluation."],
        ["Applied AI ops","Pipelines, tooling and deployment support."],
      ].map(([t,d]) => (
        <div class="card"><h3 style="margin:0 0 .2em; font-size:1rem;">{t}</h3><p class="muted" style="margin:0; font-size:14px;">{d}</p></div>
      ))}
    </div>
  </section>

  <!-- Engagement models -->
  <section class="card" style="margin-top:48px;">
    <h2 style="margin-top:0;">Engagement models</h2>
    <div class="grid" style="grid-template-columns:repeat(3,1fr);">
      <div><h3 style="font-size:1.05rem; margin:.2em 0;">Hire-train-deploy</h3><p class="muted" style="margin:0; font-size:14px;">We source, train and deploy AI/ML talent at volume for your programmes.</p></div>
      <div><h3 style="font-size:1.05rem; margin:.2em 0;">Contract staffing</h3><p class="muted" style="margin:0; font-size:14px;">Embedded resources billed as a fixed monthly cost per resource.</p></div>
      <div><h3 style="font-size:1.05rem; margin:.2em 0;">Contract-to-hire</h3><p class="muted" style="margin:0; font-size:14px;">Start on contract, convert to your payroll when it's working.</p></div>
    </div>
    <div style="margin-top:16px;"><a class="btn btn-ghost" href="/services/hire-train-deploy">See engagement models →</a></div>
  </section>

  <!-- Market gap -->
  <section class="card" style="margin-top:48px; background:var(--ink); color:#fff;">
    <h2 style="color:#fff;">The skilled human layer behind AI</h2>
    <p style="font-size:1.1rem; max-width:760px;">
      The global AI training dataset market is expected to reach <strong>USD 8.60 billion by 2030</strong>, growing at a
      <strong>21.9% CAGR (2025–2030)</strong>. The bottleneck isn't compute — it's skilled, reliable people. That's what we train and deploy.
    </p>
    <p class="muted" style="color:#94a3b8; font-size:13px;">Source: Grand View Research.</p>
  </section>

  <!-- CTA -->
  <section style="text-align:center; margin-top:48px;">
    <h2>Talent on demand, when you need it.</h2>
    <p class="muted" style="max-width:560px; margin-inline:auto;">Tell us your requirement — we'll reply within one business day.</p>
    <div class="cta-row" style="margin-top:8px;">
      <a class="btn btn-primary" href="/clients">Request talent</a>
      <a class="btn btn-ghost" href="mailto:hello@anviinnovate.com">Email us</a>
    </div>
  </section>
</Base>
