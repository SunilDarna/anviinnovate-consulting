# Copy to .env.local and fill in. .env.local is gitignored.
# PUBLIC_ vars are safe to ship in the frontend bundle (client ID is public).
PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# SERVER-ONLY — never expose in the frontend. In production these live in
# AWS SSM Parameter Store (SecureString), NOT in any committed file.
GOOGLE_CLIENT_SECRET=your-google-client-secret
SESSION_JWT_SECRET=generate-a-random-256-bit-key
